{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sylva Control",
  "mainBinaryName": "Sylva Control",
  "version": "0.7.0",
  "identifier": "app.pine.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sylva Control",
        "width": 1180,
        "height": 820,
        "minWidth": 360,
        "minHeight": 420,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Sylva",
    "category": "Utility",
    "shortDescription": "A desktop control room for streamers.",
    "longDescription": "Sylva Control shows your live viewers, alerts and channel activity, and lets you control alerts, overlays and your stream title from one window.",
    "copyright": "Copyright 2026 Sylva",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "wix": {
        "upgradeCode": "b572ea82-1e5e-5248-98b6-f1fb8ebb55a2"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwMjM3OURFNEE0MUM0MEMKUldRTXhFRkszbmtqZ09MZUdHS3V6VlRHd1Ivamhod0FpVUFUdVdya2FjNlFrUjRncFhtbWpLODUK",
      "endpoints": [
        "https://github.com/SylvaBot/sylva-control/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
