{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cortex",
  "mainBinaryName": "Cortex",
  "version": "0.2.2",
  "identifier": "app.pine.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Cortex",
        "width": 1180,
        "height": 820,
        "minWidth": 360,
        "minHeight": 420,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Cortex",
    "category": "Utility",
    "shortDescription": "A desktop control room for streamers.",
    "longDescription": "Cortex shows your live viewers, alerts and channel activity, and lets you control alerts, overlays and your stream title from one window.",
    "copyright": "Copyright 2026 haruxee",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3Q0I4OTgwMkE5QTdCRUIKUldUcmU1b3FnSW5MNTZ1dDI1bnY0NmJTTzhNT1ZyYkIyUGxzREp1aC85YmlsbnBYNDZCaldHV1oK",
      "endpoints": [
        "https://github.com/haruxee/cortex/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
